{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Constants": {
    "cookie": "gallery-cookie"
  },
  "AuthorizationOptions": {
    "RolePermissions": [
      {
        "Role": "User",
        "Permission": [ "Read" ]
      },
      {
        "Role": "Author",
        "Permission": [ "Create", "Read", "Delete", "Edit" ]
      },
      {
        "Role": "Admin",
        "Permission": ["Block", "Unblock"]
      }
    ]
  },
  "AllowedHosts": "*"
}
