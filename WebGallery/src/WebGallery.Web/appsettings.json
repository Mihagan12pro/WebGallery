{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Constants": {
    "cookie": "gallery-cookie"
  },
  "AuthorizationOptions": {
    "RolePermissions": [
      {
        "Role": "User",
        "Permissions": [ "Create", "Read", "Delete", "Edit" ]
      },
      {
        "Role": "Admin",
        "Permissions": [ "BlockUser", "UnblockUser", "Create", "Read", "Delete", "Edit" ]
      }
    ]
  },
  "AllowedHosts": "*"
}
